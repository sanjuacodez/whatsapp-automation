COMPOSE_PROJECT_NAME=whatsapp-ai-auto-reply

# Local timezone used by n8n and container logs.
TZ=Asia/Kolkata

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Optional human handoff destination used when the workflow escalates an image,
# store-details query, account/order query, or no-match product request.
HUMAN_HANDOFF_WEBHOOK_URL=

# Evolution API
EVOLUTION_API_KEY=change-this-evolution-api-key
EVOLUTION_INSTANCE=local-whatsapp
EVOLUTION_SERVER_URL=http://localhost:8080

# WooCommerce product lookup (optional)
WOOCOMMERCE_BASE_URL=https://your-store.example
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://host.docker.internal:5678/

# PostgreSQL used by Evolution API persistence
POSTGRES_USER=evolution
POSTGRES_PASSWORD=evolution
POSTGRES_DB=evolution

# Redis used by Evolution API cache/session persistence
REDIS_URL=redis://redis:6379/6